# ── CheckMate AI — environment variables ─────────────────────────────────────
# Copy this file to .env and fill in your real values.
# NEVER commit the real .env to Git.

# MongoDB
MONGO_URI=mongodb://localhost:27017
DATABASE_NAME=checkmate_ai

# JWT
JWT_SECRET=changeme_use_a_long_random_string_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Upload storage (relative to backend/)
UPLOAD_DIR=../uploads
MAX_UPLOAD_SIZE_MB=32

# LM Studio (OpenAI-compatible local LLM)
LM_STUDIO_URL=http://localhost:1234/v1/chat/completions
# Model key as shown by `lms ls` (leave empty to use whatever LM Studio has loaded)
LM_STUDIO_MODEL=qwen/qwen2.5-vl-7b
# Context window used when the launcher loads the model (multi-page PDFs need >= 12k)
LM_STUDIO_CONTEXT_LENGTH=16384
# Page images are downscaled to this longest side before being sent to the model
LLM_IMAGE_MAX_SIDE=1600

# OCR backend: lmstudio (default, reuses the loaded vision model) | chandra | none
OCR_BACKEND=lmstudio
# Reject submissions whose first page lacks the institution header (needs OCR)
REQUIRE_INSTITUTION_HEADER=true

# Allowed browser origins for the API (comma-separated). Add the GitHub Pages site
# (https://<user>.github.io) when the frontend is hosted there.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# ── Hosting the API from this PC (optional; see README "Hosting it for free") ──
# MONGO_URI above may point at MongoDB Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/
# Start-CheckMate.bat can open a public tunnel to the backend so a frontend hosted on
# GitHub Pages reaches this PC.  TUNNEL_PROVIDER: none | ngrok | cloudflared
TUNNEL_PROVIDER=none
# ngrok: your free ngrok domain (dashboard.ngrok.com -> Domains), e.g. something.ngrok-free.app
# cloudflared with your own domain on Cloudflare: the public hostname routed to the named tunnel
# cloudflared without a domain: leave empty -> a random *.trycloudflare.com address on every start
TUNNEL_DOMAIN=
# cloudflared named tunnel only: the name used with "cloudflared tunnel create <name>"
TUNNEL_NAME=
